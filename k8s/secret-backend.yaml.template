# ─── Backend Secrets (Supabase credentials) ──────────────────────────────────
# IMPORTANT: Fill in real base64-encoded values before deploying.
# Generate base64: echo -n "your-value" | base64
#
# This file is listed in .gitignore (k8s/secret-*.yaml) so it is NEVER committed.
# In CI/CD, inject secrets via your pipeline's secrets manager (e.g., GitHub Secrets,
# AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager).
#
# For production, prefer Sealed Secrets (https://github.com/bitnami-labs/sealed-secrets)
# or External Secrets Operator instead of plain Secret manifests.
#
# Template — DO NOT COMMIT WITH REAL VALUES:
apiVersion: v1
kind: Secret
metadata:
  name: arcricinfo-backend-secrets
  namespace: arcricinfo
type: Opaque
data:
  # echo -n "https://your-project.supabase.co" | base64
  SUPABASE_URL: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-anon-key" | base64
  SUPABASE_ANON_KEY: REPLACE_WITH_BASE64_ENCODED_VALUE
  # echo -n "your-service-role-key" | base64
  SUPABASE_SERVICE_ROLE_KEY: REPLACE_WITH_BASE64_ENCODED_VALUE
